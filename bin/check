#!/usr/bin/env bash
# Local CI: the single place for every check. .githooks/pre-commit and .github/workflows/ci.yml both call this.
# No installs. Exit code is non-zero if any check fails.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail=0
err() { echo "ERROR: $*" >&2; fail=1; }

echo "== Validate JSON"
n=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  n=$((n+1))
  if command -v jq >/dev/null 2>&1; then
    jq empty "$f" 2>/dev/null || err "$f: invalid JSON"
  else
    python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$f" 2>/dev/null || err "$f: invalid JSON"
  fi
done < <(git ls-files '*.json')
echo "JSON checked: $n files"

echo "== Lint SKILL.md frontmatter"
n=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  n=$((n+1))
  if [ "$(head -n1 "$f")" != "---" ]; then err "$f: no frontmatter"; continue; fi
  fm=$(awk 'NR==1{next} /^---$/{exit} {print}' "$f")
  grep -qE '^name: *[^ ]' <<<"$fm" || err "$f: missing name"
  grep -qE '^description: *[^ ]' <<<"$fm" || err "$f: missing description"
done < <(git ls-files '*SKILL.md')
echo "SKILL.md checked: $n"

echo "== CLAUDE.md imports AGENTS.md"
# Claude reads only CLAUDE.md when one exists, so it must import AGENTS.md (code.claude.com/docs/en/memory#agents-md).
if [ "$(cat CLAUDE.md 2>/dev/null)" = "@AGENTS.md" ] && [ "$(wc -l < CLAUDE.md)" -le 1 ]; then
  n=$(wc -l < AGENTS.md)
  [ "$n" -lt 200 ] || err "AGENTS.md: $n lines, must be < 200"
  echo "CLAUDE.md = @AGENTS.md; AGENTS.md $n lines"
else
  err "CLAUDE.md must be exactly one line: @AGENTS.md"
fi

echo "== make test"
if [ -f Makefile ]; then make test >/dev/null 2>&1 && echo "make test ok" || { make test 2>&1 | tail -20; err "make test failed"; }; else echo "no Makefile, skipped"; fi

if [ "$fail" -ne 0 ]; then echo "CHECK FAILED" >&2; exit 1; fi
echo "CHECK OK"
