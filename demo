#!/usr/bin/env sh
# One command, Python 3 stdlib only (DuckDB used if installed). No network, no credentials.
# Usage: ./demo [--db sqlite|duckdb]
# Exit code: 0 when every step ran. Reconcile exits 1 on purpose (the demo board holds one wrong
# figure, BF03), so that one expected "1" is not counted as a failure; any other failure is.
cd "$(dirname "$0")" || exit 1
rc=0
echo "### 1. Reconcile: every board figure recomputed through the one defined metric"
python3 bin/bfl reconcile "$@"; r=$?
[ "$r" -le 1 ] || rc=$r
echo
echo "### 2. Gate: each recorded AI answer is RELEASED, REFUSED, HOLD, MISSED or BLOCKED; score per engine"
python3 bin/bfl score board-figure-lock/answers/*.csv "$@" || rc=$?
echo
echo "### 3. Tableau check: does the workbook's Revenue calculation equal the defined metric?"
python3 bin/twb-read board-figure-lock/tableau/revenue_demo.twb --check board-figure-lock/tableau/map.json || rc=$?
exit "$rc"
